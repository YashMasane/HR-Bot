# App Settings
PROJECT_NAME="HR Bot API"

# Security (Change this in production)
SECRET_KEY="your_secret_key_here"
ALGORITHM="HS256"

# Database Connections
POSTGRES_SERVER="localhost"
POSTGRES_USER="hrbot"
POSTGRES_PASSWORD="hrpassword"
POSTGRES_DB="hrbot_db"
POSTGRES_PORT="5433"

# Redis Connections
REDIS_HOST="localhost"
REDIS_PORT="6380"

# LLM Config
DEFAULT_LLM_PROVIDER="openai" # options: openai, anthropic, gemini, etc.
DEFAULT_LLM_MODEL="gpt-4o-mini"

# API Keys (Add your actual keys here)
OPENAI_API_KEY=""
TAVILY_API_KEY=""

# LangSmith Tracing (Optional)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=""
# LANGCHAIN_PROJECT="hr-bot"
