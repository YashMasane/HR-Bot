# ============================================================
# HR Bot — Environment Configuration
# ============================================================
# Copy this file and fill in your actual keys.
# NEVER commit this file to version control.

# ------------------------------------------------------------
# OpenAI (Required)
# Used for: GPT-4o (generation), GPT-4o-mini (routing),
#           text-embedding-3-small (embeddings)
# ------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------
# LangSmith Tracing (Required — get free key at smith.langchain.com)
# ------------------------------------------------------------
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=hr-bot

# ------------------------------------------------------------
# Tavily Web Search (Optional — for web fallback node)
# Free tier at app.tavily.com
# ------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------
# LiteLLM Model Overrides (Optional)
# Uncomment to switch generation model without code changes
# ------------------------------------------------------------
# GENERATION_MODEL=gpt-4o
# ROUTER_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
